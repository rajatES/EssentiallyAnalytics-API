# Application
PORT=5000
NODE_ENV=production
FRONTEND_URL=*

# PostgreSQL (docker-compose service name = hostname)
DB_HOST=postgres-db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_strong_password
DB_NAME=social_studio_db
DB_SSL=false

# Redis (docker-compose service name = hostname)
REDIS_HOST=redis-cache
REDIS_PORT=6379

# Google BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET=your_dataset
ANALYTICS_API_KEY=your-analytics-api-key

# MSN syndication report ingest (shared secret the scraper sends as X-Ingest-Key)
MSN_INGEST_KEY=your-long-random-ingest-key

# Setup
SETUP_SECRET=your-setup-secret

# Sign-up / access control
# The one super user who can change people's access level. Seeded on boot;
# changing the password here rotates it and signs the old sessions out.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# HMAC key for sign-up codes and setup tokens (e.g. `openssl rand -hex 32`).
OTP_SIGNING_SECRET=
# Only this domain may sign up or reset a password by emailed code.
ACCESS_EMAIL_DOMAIN=essentiallysports.com

# Meta (Facebook/Instagram)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret

# SMTP (Email Reports + sign-up codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Stable Production - the Stable source workbook (one tab per event). Share it
# with the service account in GOOGLE_APPLICATION_CREDENTIALS as Viewer.
STABLE_SHEET_ID=
# Hidden tabs are the desk's archive and pivots; set true to read them too.
# STABLE_INCLUDE_HIDDEN=false
